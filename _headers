# Cloudflare Pages — HTTP headers
#
# Thiệp riêng của khách: không cho vào kết quả tìm kiếm.
# Đặt ở đây (thay vì chỉ dựa vào thẻ meta) để thiệp mới thêm sau này
# được bảo vệ tự động, không phụ thuộc việc nhớ chèn thẻ vào từng file.
# Các trang này KHÔNG bị chặn trong robots.txt — phải cho Google tải về
# thì nó mới đọc được header này.

/wedding/*
  X-Robots-Tag: noindex, nofollow

/loi-nhan/*
  X-Robots-Tag: noindex, nofollow

/card/*
  X-Robots-Tag: noindex, nofollow

# Danh sách đường tắt — luôn kiểm tra bản mới để link vừa thêm không bị báo "không tìm thấy"
/event/config.js
  Cache-Control: no-cache

/event/*
  X-Robots-Tag: noindex, nofollow

/birthday/*
  X-Robots-Tag: noindex, nofollow

/products/Invitation/Wedding/khach_*
  X-Robots-Tag: noindex, nofollow

/products/Invitation/Other/khach_*
  X-Robots-Tag: noindex, nofollow

# Thiệp khách không theo quy ước tên khach_*
/products/Invitation/Wedding/van-hoang-tran-ly/*
  X-Robots-Tag: noindex, nofollow

/products/Invitation/Wedding/van-tri-ngoc-linh/*
  X-Robots-Tag: noindex, nofollow

/products/Invitation/Other/nguyen-thong-trong-toi/*
  X-Robots-Tag: noindex, nofollow

# Preview tool — không index
/preview*
  X-Robots-Tag: noindex, nofollow

# Code demo pages — không index
/products/*/code*
  X-Robots-Tag: noindex, nofollow
