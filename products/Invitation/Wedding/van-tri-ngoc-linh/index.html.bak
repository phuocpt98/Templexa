<div id="hero-text" style="position:fixed;top:0;left:0;right:0;bottom:0;z-index:300;display:none;opacity:0;flex-direction:column;align-items:center;text-align:center;padding:5rem 1.5rem 0;pointer-events:none"><p data-t="hero-subtitle" class="text-sm md:text-base tracking-[0.4em] uppercase text-white mb-4 font-body font-semibold drop-shadow-lg">We are getting married</p><h1 class=mb-0><span class="font-display font-normal text-6xl md:text-8xl lg:text-9xl text-white block leading-[0.9] drop-shadow-lg">Diana</span><span class="font-display font-normal text-3xl md:text-4xl text-white my-4 block italic drop-shadow-lg">&amp;</span><span class="font-display font-normal text-6xl md:text-8xl lg:text-9xl text-white block leading-[0.9] drop-shadow-lg">Richard</span></h1></div>


<main id="main-site" style="display:none;opacity:0" class="bg-background text-foreground overflow-x-hidden"><div class="fixed top-4 right-4 z-50 flex gap-1 bg-background/80 backdrop-blur-sm rounded-full px-1 py-1 border border-foreground/10"><button id="lang-en" onclick="switchLang('en')" class="px-3 py-1 rounded-full text-xs font-body tracking-widest uppercase transition-colors bg-foreground text-background">EN</button><button id="lang-de" onclick="switchLang('de')" class="px-3 py-1 rounded-full text-xs font-body tracking-widest uppercase transition-colors text-foreground/60 hover:text-foreground">DE</button></div><button id="music-btn" style="position:fixed;bottom:1.5rem;right:1.5rem;z-index:40;width:3rem;height:3rem;border-radius:9999px;background:rgba(0,0,0,0.1);backdrop-filter:blur(4px);border:1px solid rgba(0,0,0,0.1);box-shadow:0 10px 15px -3px rgba(0,0,0,.1);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 0.5s ease" aria-label="Toggle music"><svg id="icon-on" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"/><path d="M16 9a5 5 0 0 1 0 6"/><path d="M19.364 18.364a9 9 0 0 0 0-12.728"/></svg><svg id="icon-off" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg></button>
<section class="relative min-h-screen flex flex-col overflow-hidden bg-white"><div class="absolute inset-0 overflow-hidden"><video playsinline class="absolute inset-0 w-full h-full object-cover" id="hero-video" src="./assets/hero-video-C3EkV1og.mp4" muted playsinline></video><div class="absolute inset-0 bg-transparent"></div></div><div class="relative z-10 flex-1 flex flex-col"><div class=flex-1></div></div><button id="scroll-btn" style="display:none" class="relative z-10 flex flex-col items-center gap-1 text-center text-white/80 hover:text-white transition-colors cursor-pointer pb-10"><span data-t="scroll-1" class="text-xs tracking-[0.3em] uppercase font-body drop-shadow-lg font-semibold">Keep scrolling</span><span data-t="scroll-2" class="text-xs tracking-[0.3em] uppercase font-body drop-shadow-lg font-semibold">and RSVP</span><div style="animation:bounce 1.5s ease-in-out infinite"><svg xmlns=http://www.w3.org/2000/svg width=24 height=24 viewBox="0 0 24 24" fill=none stroke=currentColor stroke-width=2 stroke-linecap=round stroke-linejoin=round class="lucide lucide-chevron-down w-5 h-5 drop-shadow-lg"><path d="m6 9 6 6 6-6"></path></svg></div></button></section><section id=countdown class="relative py-20 md:py-28 px-6 overflow-hidden"><img src="./assets/column-left-Deau9Trj.png" alt class="absolute h-full w-auto max-w-none pointer-events-none select-none" style=left:-8%;top:-1%><img src="./assets/column-right-DejZoXz8.png" alt class="absolute h-full w-auto max-w-none pointer-events-none select-none" style=right:-8%;top:-1%><div class="relative z-10 max-w-xl mx-auto text-center"><h2 data-t="countdown-title" class="font-display text-5xl md:text-7xl text-foreground mb-2">Countdown</h2><p data-t="countdown-until" class="text-foreground/50 text-sm font-body tracking-[0.25em] uppercase mb-12" style=opacity:1>Until 23 July 2026<div class="flex items-center justify-center"><div class="flex items-center"><div class="flex flex-col items-center px-5 md:px-8"><span id="cd-days" class="font-display text-5xl md:text-7xl text-foreground leading-none">00</span><span class="mt-3 text-xs tracking-[0.25em] uppercase text-foreground/50 font-body">Days</span></div><span class="w-px h-8 bg-foreground/15"></span></div><div class="flex items-center"><div class="flex flex-col items-center px-5 md:px-8"><span id="cd-hours" class="font-display text-5xl md:text-7xl text-foreground leading-none">00</span><span class="mt-3 text-xs tracking-[0.25em] uppercase text-foreground/50 font-body">Hours</span></div><span class="w-px h-8 bg-foreground/15"></span></div><div class="flex items-center"><div class="flex flex-col items-center px-5 md:px-8"><span id="cd-minutes" class="font-display text-5xl md:text-7xl text-foreground leading-none">00</span><span class="mt-3 text-xs tracking-[0.25em] uppercase text-foreground/50 font-body">Minutes</span></div></div></div></div></section><div class="w-10 h-px bg-foreground/15 mx-auto"></div><section class="py-20 md:py-28 px-6"><div class="max-w-2xl mx-auto"><div class="text-center mb-6"><h2 data-t="celebrations-h2" class="font-display text-5xl md:text-7xl text-foreground">The Celebrations</h2></div><div class=space-y-8><div><div class="relative z-10 flex justify-center -mb-6" style="transform:translateX(-1.52746px) translateY(-2.03662px)"><img src="./assets/yacht-illustration-BxPtm2NZ.png" alt="Yacht illustration" class="w-48 md:w-64 h-auto drop-shadow-sm" style="animation:yacht-float 4s ease-in-out infinite"></div><div class="text-center bg-foreground/[0.03] border border-foreground/10 rounded-2xl px-6 py-10 md:px-10 md:py-14"><p data-t="cruise-label" class="font-body text-sm tracking-[0.25em] uppercase text-foreground/50 mb-3">Welcome Cruise on the Bosphorus<h3 class="font-display text-5xl md:text-6xl text-foreground mb-2 leading-tight">The Peninsula<br>Private Quay</h3><p data-t="cruise-departing" class="font-body text-base text-foreground/50 mb-4">Departing from The Peninsula Private Quay<div class="w-10 h-px bg-foreground/15 mx-auto my-5"></div><div class=space-y-2><p class="font-body text-base text-foreground/60 italic tracking-wide">22 July 2026<p class="font-display text-3xl md:text-4xl text-foreground">6:30 PM</p></div><a href=https://www.google.com/maps/place/The+Peninsula+Istanbul,+Kemanke%C5%9F+Karamustafa+Pa%C5%9Fa,+Kemanke%C5%9F+Cd.+No:34,+34425+Beyo%C4%9Flu%2F%C4%B0stanbul/@41.0230125,28.9779274,17z target=_blank rel="noopener noreferrer" class="inline-block mt-5 font-body text-sm tracking-[0.15em] uppercase text-foreground/50 hover:text-foreground transition-colors border-b border-foreground/20 hover:border-foreground/50 pb-1">View on Map</a></div></div><div><div class="relative z-10 flex justify-center -mb-8"><img src="./assets/peninsula-hotel-DfDFGUc8.png" alt="The Peninsula Hotel Istanbul" class="w-56 md:w-72 h-auto drop-shadow-sm"></div><div class="text-center bg-foreground/[0.03] border border-foreground/10 rounded-2xl px-6 py-10 md:px-10 md:py-14"><p class="font-body text-sm tracking-[0.25em] uppercase text-foreground/50 mb-3">Wedding<h3 class="font-display text-5xl md:text-6xl text-foreground mb-2 leading-tight">The Peninsula<br>Hotel Istanbul</h3><div class="w-10 h-px bg-foreground/15 mx-auto my-5"></div><div class=space-y-2><p class="font-body text-base text-foreground/60 italic tracking-wide">23 July 2026<p class="font-display text-3xl md:text-4xl text-foreground">6:00 PM</p></div><a href=https://www.google.com/maps/place/The+Peninsula+Istanbul,+Kemanke%C5%9F+Karamustafa+Pa%C5%9Fa,+Kemanke%C5%9F+Cd.+No:34,+34425+Beyo%C4%9Flu%2F%C4%B0stanbul/@41.0230125,28.9779274,17z target=_blank rel="noopener noreferrer" class="inline-block mt-5 font-body text-sm tracking-[0.15em] uppercase text-foreground/50 hover:text-foreground transition-colors border-b border-foreground/20 hover:border-foreground/50 pb-1">View on Map</a></div></div></div></div></section><section class="relative py-20 md:py-28 px-6 overflow-hidden"><img src="./assets/curtain-left-new-C9yBPbWK.png" alt class="absolute w-[50%] md:w-[32%] h-auto max-w-none pointer-events-none select-none z-30" style="top:2%;transform-origin:left top;left:-22%;transform:rotate(-0.763732deg)"><img src="./assets/curtain-center-new-EwKr26ZU.png" alt class="absolute w-[68%] md:w-[50%] h-auto max-w-none pointer-events-none select-none z-40" style="top:2.2%;left:50%;transform-origin:center top;transform:translateX(-50%) rotate(0.84118deg)"><img src="./assets/curtain-right-new-Dusl3IYi.png" alt class="absolute w-[50%] md:w-[32%] h-auto max-w-none pointer-events-none select-none z-30" style="top:3%;transform-origin:right top;right:-22%;transform:rotate(-1.64991deg)"><div class="relative z-20 max-w-[260px] mx-auto pt-32 md:pt-44"><div class="text-center mb-16"><h2 data-t="weekend-h2" class="font-display text-5xl md:text-7xl text-foreground mb-2">Wedding Weekend</h2><p data-t="weekend-sub" class="font-body text-sm tracking-[0.25em] uppercase text-foreground/50 mb-1">Itinerary<p data-t="weekend-dates" class="text-foreground/60 font-body text-base tracking-wide">22 – 23 July 2026</p></div><div class=space-y-16><div><div class="text-center mb-8"><h3 class="font-display text-5xl md:text-6xl text-foreground mb-1 leading-tight">Welcome Cruise<br>on the Bosphorus</h3><p class="font-body text-base text-foreground/50 tracking-wide mb-4">22 July 2026<p data-t="cruise-join" class="font-body text-base tracking-wide text-foreground/60 italic max-w-[300px] mx-auto mb-3">Please join us for cocktails and hors d'œuvres as we sail the Bosphorus</div><div class="relative max-w-[280px] mx-auto pl-6"><div class=space-y-6><div class=relative><div class="absolute -left-[23.5px] top-[0.5rem] w-px bg-foreground/15" style="height:calc(100% + 1.5rem)"></div><div class="absolute -left-[27px] top-1 w-2 h-2 rounded-full bg-foreground/30"></div><p class="font-body text-sm font-semibold tracking-[0.15em] uppercase text-foreground/70 mb-1">6:30 PM<p data-t="cruise-departing" class="font-body text-base tracking-[0.05em] text-foreground">Departure from The Peninsula Private Quay</p></div><div class=relative><div class="absolute -left-[23.5px] top-[0.5rem] w-px bg-foreground/15" style="height:calc(100% + 1.5rem)"></div><div class="absolute -left-[27px] top-1 w-2 h-2 rounded-full bg-foreground/30"></div><p class="font-body text-sm font-semibold tracking-[0.15em] uppercase text-foreground/70 mb-1">6:30 – 9:30 PM<p data-t="cruise-cocktails" class="font-body text-base tracking-[0.05em] text-foreground">Sunset Cocktails &amp; Hors d'Œuvres</p></div><div class=relative><div class="absolute -left-[27px] top-1 w-2 h-2 rounded-full bg-foreground/30"></div><p class="font-body text-sm font-semibold tracking-[0.15em] uppercase text-foreground/70 mb-1">10:00 PM<p data-t="cruise-arrival" class="font-body text-base tracking-[0.05em] text-foreground">Arrival at The Peninsula Private Quay</p></div></div></div><div class="flex justify-center mt-14 mb-2"><img src="./assets/candles-BlDM94c8.png" alt class="w-40 h-auto pointer-events-none select-none"></div></div><div><div class="text-center mb-8"><h3 class="font-display text-5xl md:text-6xl text-foreground mb-1 leading-tight">Wedding</h3><p class="font-body text-base text-foreground/50 tracking-wide mb-4">23 July 2026 · The Peninsula Hotel Istanbul</p></div><div class="relative max-w-[280px] mx-auto pl-6"><div class=space-y-6><div class=relative><div class="absolute -left-[23.5px] top-[0.5rem] w-px bg-foreground/15" style="height:calc(100% + 1.5rem)"></div><div class="absolute -left-[27px] top-1 w-2 h-2 rounded-full bg-foreground/30"></div><p class="font-body text-sm font-semibold tracking-[0.15em] uppercase text-foreground/70 mb-1">6:00 PM<p data-t="wedding-drinks" class="font-body text-base tracking-[0.05em] text-foreground">Arrival &amp; Welcome Drinks</p></div><div class=relative><div class="absolute -left-[23.5px] top-[0.5rem] w-px bg-foreground/15" style="height:calc(100% + 1.5rem)"></div><div class="absolute -left-[27px] top-1 w-2 h-2 rounded-full bg-foreground/30"></div><p data-t="wedding-ceremony" class="font-body text-base tracking-[0.05em] text-foreground/50 italic">Ceremony</p></div><div class=relative><div class="absolute -left-[23.5px] top-[0.5rem] w-px bg-foreground/15" style="height:calc(100% + 1.5rem)"></div><div class="absolute -left-[27px] top-1 w-2 h-2 rounded-full bg-foreground/30"></div><p data-t="wedding-banquet" class="font-body text-base tracking-[0.05em] text-foreground/50 italic">Banquet</p></div><div class=relative><div class="absolute -left-[23.5px] top-[0.5rem] w-px bg-foreground/15" style="height:calc(100% + 1.5rem)"></div><div class="absolute -left-[27px] top-1 w-2 h-2 rounded-full bg-foreground/30"></div><p data-t="wedding-party" class="font-body text-base tracking-[0.05em] text-foreground/50 italic">Party</p></div><div class=relative><div class="absolute -left-[27px] top-1 w-2 h-2 rounded-full bg-foreground/30"></div><p data-t="wedding-after" class="font-body text-base tracking-[0.05em] text-foreground/50 italic">After Party</p></div></div></div><div class="absolute -right-12 -bottom-4"><img src="./assets/flower-vase-B9_turUq.png" alt class="w-36 h-auto pointer-events-none select-none"></div></div></div></div></section><div class="w-10 h-px bg-foreground/15 mx-auto"></div><section class="py-20 md:py-28 px-6 overflow-hidden"><div class="relative max-w-2xl mx-auto text-center"><img src="./assets/bouquet-BbYUpj3K.png" alt class="absolute top-8 -left-10 md:-left-16 w-44 md:w-52 h-auto pointer-events-none select-none z-10"><img src="./assets/flower-stand-BmJQHDXB.png" alt class="absolute -right-12 md:-right-20 top-[45%] w-28 md:w-36 h-auto pointer-events-none select-none z-10"><img src="./assets/cypress-trees-Bn8J7j_a.png" alt class="absolute -bottom-16 -left-8 md:-left-16 w-36 md:w-48 h-auto pointer-events-none select-none z-10"><div><h2 data-t="dresscode-h2" class="font-display text-5xl md:text-7xl text-foreground mb-10">Dress Code</h2><div class=space-y-8><div class="bg-foreground/[0.03] border border-foreground/10 rounded-2xl px-6 py-10 md:px-10 md:py-14"><h3 data-t="dress-cruise-name" class="font-display text-4xl md:text-5xl text-foreground mb-1 leading-tight">Welcome Cruise</h3><p data-t="dress-cruise-date" class="font-body text-sm tracking-[0.25em] uppercase text-foreground/50 mb-4">22nd July<p data-t="dress-white" class="font-body text-lg tracking-[0.1em] text-foreground">White Cocktail Attire</p></div><div class="bg-foreground/[0.03] border border-foreground/10 rounded-2xl px-6 py-10 md:px-10 md:py-14"><h3 data-t="dress-wedding-name" class="font-display text-4xl md:text-5xl text-foreground mb-1 leading-tight">Wedding</h3><p data-t="dress-wedding-date" class="font-body text-sm tracking-[0.25em] uppercase text-foreground/50 mb-4">23rd July<p class="font-body text-lg tracking-[0.1em] text-foreground">Black Tie</p></div></div></div></div></section><div class="w-10 h-px bg-foreground/15 mx-auto"></div><section class="py-20 md:py-28 px-6 overflow-hidden"><div class="max-w-2xl mx-auto"><div class="text-center mb-14"><h2 data-t="stay-h2" class="font-display text-5xl md:text-7xl text-foreground mb-2">Where to Stay</h2><p data-t="stay-sub" class="font-body text-foreground/50 tracking-[0.25em] uppercase text-sm">Recommended hotels near the venue</p></div><div class=space-y-12><div class=relative><div class="relative z-0 flex -mt-16 justify-start -ml-8 md:-ml-16 mb-4"><img src="./assets/hotel-peninsula-Is4jSbdC.png" alt class="w-56 md:w-80 h-auto drop-shadow-sm pointer-events-none select-none"></div><div class="relative z-10 text-center"><h3 class="font-display text-4xl md:text-5xl text-foreground mb-1 leading-tight">The Peninsula Istanbul</h3><p class="font-display text-4xl md:text-5xl text-foreground mb-1">€735<p class="font-body text-sm text-foreground/50 tracking-wide mb-2"><span data-t="hotel-per-night">per night · double standard room · incl. taxes &amp; breakfast</span><p class="font-body text-sm tracking-[0.15em] uppercase text-foreground/40 italic"><span data-t="booking-soon">Booking link coming soon</span></p></div></div><div class=relative><div class="relative z-0 flex -mt-8 justify-center mb-4"><img src="./assets/hotel-marriott-wV0E4Iky.png" alt class="w-64 md:w-[22rem] h-auto drop-shadow-sm pointer-events-none select-none"></div><div class="relative z-10 text-center"><h3 class="font-display text-4xl md:text-5xl text-foreground mb-1 leading-tight">JW Marriott Istanbul</h3><p class="font-display text-4xl md:text-5xl text-foreground mb-1">€314<p class="font-body text-sm text-foreground/50 tracking-wide mb-2"><span data-t="hotel-per-night">per night · double standard room · incl. taxes &amp; breakfast</span><p class="font-body text-sm tracking-[0.15em] uppercase text-foreground/40 italic"><span data-t="booking-soon">Booking link coming soon</span></p></div></div><div class=relative><div class="absolute -right-20 md:-right-[30%] -top-16 z-0 pointer-events-none select-none"><img src="./assets/hotel-novotel-CUyCHsIf.png" alt class="w-56 md:w-72 h-auto"></div><div class="relative z-10 text-center pt-8"><h3 class="font-display text-4xl md:text-5xl text-foreground mb-1 leading-tight">Novotel Istanbul</h3><p class="font-display text-4xl md:text-5xl text-foreground mb-1">€192<p class="font-body text-sm text-foreground/50 tracking-wide mb-2"><span data-t="hotel-per-night">per night · double standard room · incl. taxes &amp; breakfast</span><p class="font-body text-sm tracking-[0.15em] uppercase text-foreground/40 italic"><span data-t="booking-soon">Booking link coming soon</span></p></div></div></div></div></section><div class="w-10 h-px bg-foreground/15 mx-auto"></div><section class="py-20 md:py-28 px-6 overflow-hidden"><div class="relative max-w-2xl mx-auto"><img src="./assets/roses-top-left-D0RRxzlV.png" alt class="absolute -top-8 -left-12 md:-left-16 w-36 md:w-44 h-auto pointer-events-none select-none z-10" style="transform:translateY(0.382663px) rotate(-0.191331deg)"><img src="./assets/roses-bottom-right-C-Wj2fia.png" alt class="absolute -bottom-8 -right-12 md:-right-16 w-36 md:w-44 h-auto pointer-events-none select-none z-10" style="transform:translateY(0.396055px) rotate(-0.198028deg)"><div class="bg-foreground/[0.03] border border-foreground/10 rounded-2xl px-6 py-10 md:px-10 md:py-14 text-center"><h2 data-t="gift-h2" class="font-display text-5xl md:text-7xl text-foreground mb-8">Wedding Gift</h2><p data-t="gift-text" class="text-foreground/70 font-body text-lg md:text-xl leading-relaxed italic mb-4">Your presence is our greatest gift.<p data-t="gift-details" class="text-foreground/50 font-body text-base leading-relaxed">If you wish to honour us with a gift, we kindly prefer monetary contributions. Bank details will be shared separately.</p></div></div></section><div class="w-10 h-px bg-foreground/15 mx-auto"></div><section id="rsvp" class="py-20 md:py-28 px-6"><div class="max-w-2xl mx-auto"><div><div class="text-center mb-14"><h2 data-t="rsvp-h2" class="font-display text-5xl md:text-7xl text-foreground mb-2">Rsvp</h2><p data-t="rsvp-sub" class="font-body text-foreground/50 text-sm tracking-[0.25em] uppercase">The favour of a reply is kindly requested by the fifteenth of June, 2026</p></div><form id="rsvp-form" class="space-y-8" novalidate><div class="absolute -left-[9999px] opacity-0" aria-hidden=true><label for=website>Website</label><input type=text id=website name=website tabindex=-1 autocomplete=off value></div><div><label data-t="rsvp-attend-q" class="font-medium peer-disabled:cursor-not-allowed peer-disabled:opacity-70 text-foreground font-body text-base tracking-wide">Will you be joining us? *</label><div role=radiogroup aria-required=false dir=ltr class="flex flex-col gap-3 mt-3" tabindex=0 style=outline:none><div class="flex items-start space-x-2"><button type=button role=radio aria-checked=true data-state=checked value=yes class="aspect-square h-4 w-4 rounded-full border ring-offset-background focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 border-foreground/30 text-foreground mt-0.5" id=yes tabindex=-1 data-radix-collection-item><span data-state=checked class="flex items-center justify-center"><svg xmlns=http://www.w3.org/2000/svg width=24 height=24 viewBox="0 0 24 24" fill=none stroke=currentColor stroke-width=2 stroke-linecap=round stroke-linejoin=round class="lucide lucide-circle h-2.5 w-2.5 fill-current text-current"><circle cx=12 cy=12 r=10></circle></svg></span></button><input type=radio aria-hidden=true tabindex=-1 value=yes checked style=transform:translateX(-100%);position:absolute;pointer-events:none;opacity:0;margin:0px;width:16px;height:16px><label data-t="rsvp-yes" class="font-medium peer-disabled:cursor-not-allowed peer-disabled:opacity-70 cursor-pointer text-foreground font-body text-base" for=yes>Delighted to accept</label></div><div class="flex items-start space-x-2"><button type=button role=radio aria-checked=false data-state=unchecked value=no class="aspect-square h-4 w-4 rounded-full border ring-offset-background focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 border-foreground/30 text-foreground mt-0.5" id=no tabindex=-1 data-radix-collection-item></button><input type=radio aria-hidden=true tabindex=-1 value=no style=transform:translateX(-100%);position:absolute;pointer-events:none;opacity:0;margin:0px;width:16px;height:16px><label data-t="rsvp-no" class="font-medium peer-disabled:cursor-not-allowed peer-disabled:opacity-70 cursor-pointer text-foreground font-body text-base" for=no>Regretfully unable to attend</label></div></div></div><div class=space-y-3><label data-t="rsvp-events-q" class="font-medium peer-disabled:cursor-not-allowed peer-disabled:opacity-70 text-foreground font-body text-base tracking-wide">Which events will you be attending? *</label><div class=space-y-2><div class="flex items-center space-x-3"><button type=button role=checkbox aria-checked=false data-state=unchecked value=on class="peer h-4 w-4 shrink-0 rounded-sm border ring-offset-background data-[state=checked]:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 border-foreground/30 data-[state=checked]:bg-foreground data-[state=checked]:border-foreground" id=event-cruise></button><input type=checkbox aria-hidden=true tabindex=-1 value=on style=position:absolute;pointer-events:none;opacity:0;margin:0px;transform:translateX(-100%);width:16px;height:16px><label data-t="rsvp-event-cruise" class="font-medium peer-disabled:cursor-not-allowed peer-disabled:opacity-70 cursor-pointer text-foreground font-body text-base" for=event-cruise>Welcome Cruise – 22nd July</label></div><div class="flex items-center space-x-3"><button type=button role=checkbox aria-checked=false data-state=unchecked value=on class="peer h-4 w-4 shrink-0 rounded-sm border ring-offset-background data-[state=checked]:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 border-foreground/30 data-[state=checked]:bg-foreground data-[state=checked]:border-foreground" id=event-wedding></button><input type=checkbox aria-hidden=true tabindex=-1 value=on style=position:absolute;pointer-events:none;opacity:0;margin:0px;transform:translateX(-100%);width:16px;height:16px><label data-t="rsvp-event-wedding" class="font-medium peer-disabled:cursor-not-allowed peer-disabled:opacity-70 cursor-pointer text-foreground font-body text-base" for=event-wedding>Wedding Ceremony &amp; Reception – 23rd July</label></div></div></div><div class=space-y-4><div class="flex items-center gap-2"><svg xmlns=http://www.w3.org/2000/svg width=24 height=24 viewBox="0 0 24 24" fill=none stroke=currentColor stroke-width=2 stroke-linecap=round stroke-linejoin=round class="lucide lucide-users w-4 h-4 text-foreground/50"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx=9 cy=7 r=4></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg><label data-t="rsvp-guests-q" class="font-medium peer-disabled:cursor-not-allowed peer-disabled:opacity-70 text-foreground font-body text-base tracking-wide">Number of guests in your party</label></div><div class="flex items-center gap-2"><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 border-2 bg-transparent hover:border-ivory h-10 w-10 border-foreground/20 text-foreground hover:bg-foreground/5 font-body" type=button disabled>-</button><span class="w-10 text-center text-lg font-body text-foreground">1</span><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 border-2 bg-transparent hover:border-ivory h-10 w-10 border-foreground/20 text-foreground hover:bg-foreground/5 font-body" type=button>+</button></div></div><div class=space-y-6><div class="space-y-3 pb-6 border-b border-foreground/10 last:border-0"><label data-t="rsvp-principal" class="font-medium peer-disabled:cursor-not-allowed peer-disabled:opacity-70 text-sm text-foreground font-body tracking-wide">Principal guest</label><input class="flex h-10 w-full rounded-md border px-3 py-2 text-base ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm bg-transparent border-foreground/20 text-foreground placeholder:text-foreground/40 focus:border-foreground/50 font-body" required data-ph="rsvp-ph-name" placeholder="Full name" value><input type=email class="flex h-10 w-full rounded-md border px-3 py-2 text-base ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm bg-transparent border-foreground/20 text-foreground placeholder:text-foreground/40 focus:border-foreground/50 font-body" required data-ph="rsvp-ph-email" placeholder="Email address" value></div></div><div class=space-y-4><label data-t="rsvp-children-q" class="font-medium peer-disabled:cursor-not-allowed peer-disabled:opacity-70 text-foreground font-body text-base tracking-wide">Will any children be accompanying you?</label><div role=radiogroup aria-required=false dir=ltr class="flex flex-col gap-3" tabindex=0 style=outline:none><div class="flex items-center space-x-2"><button type=button role=radio aria-checked=false data-state=unchecked value=yes class="aspect-square h-4 w-4 rounded-full border ring-offset-background focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 border-foreground/30 text-foreground" id=children-yes tabindex=-1 data-radix-collection-item></button><input type=radio aria-hidden=true tabindex=-1 value=yes style=transform:translateX(-100%);position:absolute;pointer-events:none;opacity:0;margin:0px;width:16px;height:16px><label data-t="rsvp-children-yes" class="font-medium peer-disabled:cursor-not-allowed peer-disabled:opacity-70 cursor-pointer text-foreground font-body text-base" for=children-yes>Yes</label></div><div class="flex items-center space-x-2"><button type=button role=radio aria-checked=true data-state=checked value=no class="aspect-square h-4 w-4 rounded-full border ring-offset-background focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 border-foreground/30 text-foreground" id=children-no tabindex=-1 data-radix-collection-item><span data-state=checked class="flex items-center justify-center"><svg xmlns=http://www.w3.org/2000/svg width=24 height=24 viewBox="0 0 24 24" fill=none stroke=currentColor stroke-width=2 stroke-linecap=round stroke-linejoin=round class="lucide lucide-circle h-2.5 w-2.5 fill-current text-current"><circle cx=12 cy=12 r=10></circle></svg></span></button><input type=radio aria-hidden=true tabindex=-1 value=no checked style=transform:translateX(-100%);position:absolute;pointer-events:none;opacity:0;margin:0px;width:16px;height:16px><label data-t="rsvp-children-no" class="font-medium peer-disabled:cursor-not-allowed peer-disabled:opacity-70 cursor-pointer text-foreground font-body text-base" for=children-no>No</label></div></div></div><div><label data-t="rsvp-message-q" class="font-medium peer-disabled:cursor-not-allowed peer-disabled:opacity-70 text-foreground font-body text-base tracking-wide" for=message>A message for the couple</label><textarea class="flex w-full rounded-md border px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 mt-2 bg-transparent border-foreground/20 text-foreground placeholder:text-foreground/40 focus:border-foreground/50 min-h-[100px] font-body" id=message data-ph="rsvp-ph-message" placeholder="We should be delighted to hear from you."></textarea></div><div class=relative><img src="./assets/vase-left-DfaX_fU4.png" alt class="absolute -left-20 md:-left-32 -bottom-40 w-36 md:w-48 h-auto pointer-events-none select-none z-20"><img src="./assets/vase-right-BfgTPz8l.png" alt class="absolute -right-20 md:-right-32 -bottom-40 w-36 md:w-48 h-auto pointer-events-none select-none z-20"><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 border border-gold/30 h-10 px-4 relative z-10 w-full bg-foreground hover:bg-foreground/90 text-background font-body tracking-[0.15em] uppercase text-sm py-6 rounded-lg" type=submit><span class="flex items-center gap-2"><svg xmlns=http://www.w3.org/2000/svg width=24 height=24 viewBox="0 0 24 24" fill=none stroke=currentColor stroke-width=2 stroke-linecap=round stroke-linejoin=round class="lucide lucide-send w-4 h-4"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path><path d="m21.854 2.147-10.94 10.939"></path></svg id="rsvp-submit-btn"><span data-t="rsvp-submit">Submit Response</span></span></button></div><p id="rsvp-error" style="display:none;color:hsl(0,65%,45%)" class="text-center text-sm font-body">We were unable to record your response. Kindly try again.</p></form></div></div>
<div id="thanks-yes" style="display:none" class="text-center space-y-4 font-body text-foreground/70 text-base leading-relaxed"><h3 class="font-display text-5xl md:text-6xl text-foreground mb-4">With Gratitude</h3><p>Thank you for your gracious response.</p><p>We look forward to welcoming you on:</p><p class="font-body text-sm tracking-[0.15em] uppercase text-foreground mt-2">23 July 2026 · The Peninsula Hotel Istanbul</p></div><div id="thanks-no" style="display:none" class="text-center space-y-4 font-body text-foreground/70 text-base leading-relaxed"><h3 class="font-display text-5xl md:text-6xl text-foreground mb-4">With Gratitude</h3><p>We are sorry to learn that you are unable to join us.</p></div>
</section><footer class="py-20 text-center px-6"><div style=opacity:1><img src="./assets/monogram-Dd4GSvtc.png" alt="D&amp;R monogram" class="w-24 md:w-28 h-auto mx-auto mb-8 pointer-events-none select-none"><p class="font-display text-5xl md:text-6xl text-foreground mb-4 leading-tight">Diana <span class="text-3xl md:text-4xl text-foreground/50 italic">&amp;</span> Richard<p class="text-base text-foreground/50 font-body tracking-wide">23 July 2026<p class="text-sm text-foreground/40 mt-16 font-body">Made with love by <a href=https://www.thedigitalyes.com/ target=_blank rel="noopener noreferrer" class="hover:text-foreground transition-colors underline underline-offset-2">The Digital Yes</a></p></div></footer>
<audio id="bg-music" src="./assets/wedding-background-music-yxy0nS2O.mp3" loop></audio>
</main>

